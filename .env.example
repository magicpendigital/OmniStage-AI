# OmniStage AI — copy this file to `.env` and fill in only what you use. Everything is optional:
# without any key the AI Director runs offline (built-in heuristic director), and keys typed in
# Settings → AI (stored in your browser) take precedence over these server-side defaults.

# Port of the local server (default 3000)
PORT=3000

# Default AI provider when the studio does not pick one:
# gemini | anthropic | openrouter | openai-compatible | cli-claude | cli-codex | cli-antigravity | cli-opencode
OMNISTAGE_AI_PROVIDER=""

# API keys (server-side defaults)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
# For openai-compatible: e.g. https://api.openai.com/v1 or http://localhost:11434/v1 (Ollama)
OPENAI_BASE_URL=""

# Local workspace for projects, personal library, extensions and memory (default: ~/OmniStage)
OMNISTAGE_HOME=""
