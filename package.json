{
  "name": "omnistage-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts --prod",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test:renderer": "tsx --test tests/animationCrossFade.test.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm test",
    "mcp": "tsx mcp/server.ts",
    "review:agent": "bash scripts/agent-review.sh",
    "build:player": "node scripts/build-player.mjs",
    "test:e2e": "node scripts/build-player.mjs && playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@google/genai": "^3.0.0",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mediabunny": "^1.65.2",
    "motion": "^12.23.24",
    "onnxruntime-web": "1.18.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
